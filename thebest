-- KEY TYPE DETECTION SYSTEM
-- Free keys: start with "SNOWY-FREE-" prefix
-- Premium keys: anything else (routed to Jnkie SDK)
-- ══════════════════════════════════════════════════════════
local FREE_KEY_PREFIX = "SNOWY-FREE-"
local FREE_KEYS_URL = "https://raw.githubusercontent.com/adubwon/nex/refs/heads/main/freekeys.txt"

-- Hardcoded fallback free keys (always work even if URL fails)
local FALLBACK_FREE_KEYS = {
    "SNOWY-FREE-LAUNCH2024",
    "SNOWY-FREE-DISCORD",
    "SNOWY-FREE-TRIAL01",
}

-- Fetch free keys from remote (cached after first fetch)
local cachedFreeKeys = nil
local function getFreeKeys()
    if cachedFreeKeys then return cachedFreeKeys end
    cachedFreeKeys = {}
    -- Add fallbacks first
    for _, k in ipairs(FALLBACK_FREE_KEYS) do
        cachedFreeKeys[k:upper()] = true
    end
    -- Try remote fetch
    pcall(function()
        local raw = game:HttpGet(FREE_KEYS_URL)
        for line in raw:gmatch("[^\n]+") do
            local trimmed = line:match("^%s*(.-)%s*$")
            if #trimmed > 0 then
                cachedFreeKeys[trimmed:upper()] = true
            end
        end
    end)
    return cachedFreeKeys
end

-- Pre-fetch in background
task.spawn(getFreeKeys)

-- Key type detector
local function detectKeyType(text)
    if #text == 0 then return "none" end
    if text:upper():sub(1, #FREE_KEY_PREFIX) == FREE_KEY_PREFIX:upper() then
        return "free"
    end
    return "premium"
end

