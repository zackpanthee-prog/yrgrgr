-- MASTER RENDER LOOP (Enhanced Animations & Parallax)
-- ═══════════════════════════════════════════════════════════
local masterConn
-- Consolidated animation state (single render loop - much cheaper than many task.spawn loops)
local tPulse, snowRot, hue = 0, 0, 0
local inputGlowT, getKeyGlowT, ringRot = 0, 0, 0
local gkArrowT, gkAuraT = 0, 0  -- Get Key button animations
local frameCount = 0
-- Pre-cache UIStroke reference for getKeyBtn to avoid per-frame GetChildren
local getKeyStroke = nil
task.defer(function()
    if getKeyBtn then
        for _, c in pairs(getKeyBtn:GetChildren()) do
            if c:IsA("UIStroke") then getKeyStroke = c break end
        end
    end
end)

masterConn = RunService.Heartbeat:Connect(function(dt)
    if not Screen or not Screen.Parent then
        masterConn:Disconnect()
        return
    end
    frameCount = frameCount + 1
    tPulse = tPulse + dt

    -- Run all direct-property animations every frame (cheap math only)
    pcall(function()
        -- 1) Center border rainbow glow
        hue = (hue + dt * 0.12) % 1
        centerStroke.Color = Color3.fromHSV(hue * 0.15 + 0.55, 0.65, 1)

        -- 2) Snowflake spin
        snowRot = (snowRot + dt * 28) % 360
        snowEmoji.Rotation = snowRot

        -- 3) Logo float
        local yOff = math.sin(tPulse * 3.5) * 7
        logoBox.Position = UDim2.new(0.5, -45, 0, 68 + yOff)
        logoAura.Position = UDim2.new(0.5, -55, 0, 58 + yOff)
        logoAura.BackgroundTransparency = 0.84 + math.sin(tPulse * 1.1) * 0.07
        sparkleHolder.Position = UDim2.new(0.5, -65, 0, 48 + yOff)

        -- 4) Orbiting sparkle particles
        for _, s in ipairs(sparkles) do
            s.angle = s.angle + dt * s.speed
            local sa = math.sin(tPulse * 2.5 + s.angle)
            s.frame.Position = UDim2.new(0, math.cos(s.angle) * s.radius + 63, 0, math.sin(s.angle) * s.radius + 63)
            s.frame.BackgroundTransparency = 0.25 + sa * 0.25
        end

        -- 5) Input breathing glow
        if not inputFocused then
            inputGlowT = inputGlowT + dt * 1.8
            inputStroke.Transparency = 0.45 + math.sin(inputGlowT) * 0.15
        end

        -- 6) Get Key stroke pulse (cached ref, no GetChildren)
        if getKeyStroke then
            getKeyGlowT = getKeyGlowT + dt * 2.2
            getKeyStroke.Transparency = 0.18 + math.sin(getKeyGlowT) * 0.1
        end

        -- 7) Security badge pulse
        secBadge.BackgroundTransparency = 0.86 + math.sin(tPulse * 0.7) * 0.05

        -- 8) Premium banner border glow
        premStroke.Color = Color3.fromHSV((hue * 0.3 + 0.75) % 1, 0.6, 1)

        -- 9) Avatar ring gradient rotation (every 2nd frame - still smooth at 30fps)
        if frameCount % 2 == 0 then
            ringRot = (ringRot + 1.5) % 360
            ringGrad.Rotation = ringRot
        end

        -- 10) Online dot pulse (pure sine, no tween objects)
        onlineDot.BackgroundTransparency = 0.3 + math.sin(tPulse * 1.6) * 0.3

        -- 11) Status dot pulse
        statusDot.BackgroundTransparency = 0.25 + math.sin(tPulse * 1.4) * 0.35

        -- 12) Get Key arrow bounce (direct math, no tween allocation)
        gkArrowT = gkArrowT + dt * 3.5
        local arrowOff = math.sin(gkArrowT) * 3
        gkArrow.Position = UDim2.new(1, -24 + arrowOff, 0, 0)
        gkArrow.TextTransparency = 0.15 + (math.sin(gkArrowT) * 0.5 + 0.5) * 0.2

        -- 13) Get Key aura + stroke pulse (direct math)
        gkAuraT = gkAuraT + dt * 2.5
        getKeyAura.BackgroundTransparency = 0.72 + math.sin(gkAuraT) * 0.12
        getKeyStrokeObj.Thickness = 2 + math.sin(gkAuraT) * 1.4

        -- Heavy ops: cursor parallax + mouse aura — only every 4th frame (~15fps, imperceptible)
        if frameCount % 4 == 0 then
            local mouse = UserInputService:GetMouseLocation()
            local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
            if vp and vp.X > 0 then
                local mx = (mouse.X / vp.X - 0.5) * 2
                local my = (mouse.Y / vp.Y - 0.5) * 2
                leftPanel.Position = UDim2.new(0, mx * -3, 0, my * -2)
                centerPanel.Position = UDim2.new(0, 205 + mx * -1.5, 0, my * -1)
                rightPanel.Position = UDim2.new(0, 555 + mx * 3, 0, my * -2)
                local cpAbs = centerPanel.AbsolutePosition
                local cpSize = centerPanel.AbsoluteSize
                local lx = mouse.X - cpAbs.X
                local ly = mouse.Y - cpAbs.Y
                if lx > 0 and ly > 0 and lx < cpSize.X and ly < cpSize.Y then
                    mouseAura.Visible = true
                    mouseAura.Position = UDim2.new(0, lx - 90, 0, ly - 90)
                    mouseAura.BackgroundTransparency = 0.89 + math.sin(tPulse * 1.8) * 0.04
                else
                    mouseAura.Visible = false
                end
            end
        end
    end)
end)

