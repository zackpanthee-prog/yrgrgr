-- ══════════════════════════════════════════════════════════════
-- JNKIE API (Direct HTTP — no SDK loadstring needed)
-- ══════════════════════════════════════════════════════════════
-- Uses Jnkie's public REST API directly instead of loading their SDK
-- via loadstring. Loading the SDK caused Jnkie's built-in UI to
-- spawn and show "No script key provided, please pass a SCRIPT_KEY!"
-- because the SDK expects SCRIPT_KEY pre-set by their own loader.
--
-- By calling the API directly we avoid that conflict entirely and
-- let our custom UI handle everything.

local HttpService = game:GetService("HttpService")
local httpRequest = (syn and syn.request) or request or http_request or http.request

local JNKIE_BASE_URL = "https://api.jnkie.com/api/v1/whitelist"

-- Core Tier Config
local FREE_PROJECT_ID = "19097"
local PREMIUM_PROJECT_ID = "16550"
local FREE_PROVIDERS = {"lootlabs", "workink"}

local Junkie = {}
Junkie.service    = "snowy hub"
Junkie.identifier = FREE_PROJECT_ID
Junkie.provider   = FREE_PROVIDERS[1]

function Junkie.check_key(key)
    if not Junkie.service then error("service not set") end
    local ok, resp = pcall(function()
        return httpRequest({
            Method = "POST",
            Url = JNKIE_BASE_URL .. "/verifyOpen",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                key = tostring(key or ""),
                service = Junkie.service,
                identifier = tostring(Junkie.identifier or "unknown")
            })
        })
    end)
    if not ok or not resp then
        return {valid = false, error = "HTTP_ERROR"}
    end
    if resp.StatusCode ~= 200 then
        return {valid = false, error = "http " .. tostring(resp.StatusCode)}
    end
    local decodeOk, body = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not decodeOk then
        return {valid = false, error = "DECODE_ERROR"}
    end
    return body
end

function Junkie.get_key_link(provider)
    if not Junkie.service then error("service not set") end
    if not Junkie.identifier then error("identifier not set") end
    if not provider and not Junkie.provider then error("provider not set") end

    local ok, resp = pcall(function()
        return httpRequest({
            Method = "POST",
            Url = JNKIE_BASE_URL .. "/getKeyOpen",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                service = Junkie.service,
                provider = tostring(provider or Junkie.provider),
                identifier = tostring(Junkie.identifier)
            })
        })
    end)
    if not ok or not resp then return nil, "HTTP_ERROR" end
    if resp.StatusCode == 429 then return nil, "RATE_LIMITED" end
    if resp.StatusCode ~= 200 then return nil, resp.Body or "HTTP_ERROR" end
    return resp.Body, nil
end

-- Helper that returns the SDK table (drop-in replacement for old getSDK)
local function getSDK(key)
    return Junkie
end

